  Dialogues:
  - Avatar: {fileID: 21300000, guid: 522baf863f6c0bf4fbb3e2cf819f1c5f, type: 3}
    Name: 
    text: "Ol\xE1 companheiro, vejo que voc\xEA progrediu..."
  - Avatar: {fileID: 21300000, guid: 0f64760a6ae6dd64abf8d6b21d82e5b8, type: 3}
    Name: 
    text: "e vejo que voc\xEA est\xE1 precisando de ajuda, oque aconteceu, porque
