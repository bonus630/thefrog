--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 952607ffee8a03242a8f9d6155c28800, type: 3}
  m_Name: DialogueNPCPrisionierOpenedDoor
  m_EditorClassIdentifier: 
  DialogueName: PrisonBreak
  Dialogues:
  - Avatar: {fileID: 21300000, guid: 522baf863f6c0bf4fbb3e2cf819f1c5f, type: 3}
    Name: 
    text: "Obrigado por isso.  Fui capturado quando derrotei o porc\xE3o que estava
      neste castelo."
  - Avatar: {fileID: 21300000, guid: 0f64760a6ae6dd64abf8d6b21d82e5b8, type: 3}
    Name: 
    text: Outro porco
  - Avatar: {fileID: 21300000, guid: 522baf863f6c0bf4fbb3e2cf819f1c5f, type: 3}
    Name: 
    text: "Mas o Rei ainda est\xE1 sobre controle, creio que \xE9 o feiticeiro que
      tem esse poder. Mas eu n\xE3o tenho for\xE7a suficientes para enfrenta-l\xF3"
  - Avatar: {fileID: 21300000, guid: 522baf863f6c0bf4fbb3e2cf819f1c5f, type: 3}
    Name: 
    text: "Vou deixar essa tarefa com voc\xEA, mas n\xE3o tente enfrenta-l\xF3 sozinho,
      busque ajuda... "
  - Avatar: {fileID: 21300000, guid: 522baf863f6c0bf4fbb3e2cf819f1c5f, type: 3}
    Name: 
    text: "Perto de Alysky voc\xEA pode encontrar uma criatura forte o suficiente
      para ajudar"
  - Avatar: {fileID: 21300000, guid: 522baf863f6c0bf4fbb3e2cf819f1c5f, type: 3}
    Name: 
    text: "Um dos transportes passa bem perto de l\xE1, voc\xEA pode encontra-l\xF3
      na cidade. Conto com voc\xEA..."
  - Avatar: {fileID: 21300000, guid: 0f64760a6ae6dd64abf8d6b21d82e5b8, type: 3}
    Name: 
    text: "Acho que ele n\xE3o sabe que os transportes est\xE3o desativados"
